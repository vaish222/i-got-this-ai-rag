# Optional first name displayed in the Streamlit greeting.
APP_USER_NAME=

# Free local models served by Ollama; no API key is required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_CHAT_MODEL=gemma3:1b

# Provider-neutral generation settings. These take precedence over
# OLLAMA_CHAT_MODEL for application generation.
LLM_PROVIDER=ollama
LLM_API_STYLE=ollama
LLM_MODEL=gemma3:1b
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=30
# Optional positive cap; leave blank to use the provider/model default.
LLM_MAX_OUTPUT_TOKENS=

# Model and Qwen concise-generation comparison settings for Nebius Token Factory.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL_1=
NEBIUS_MODEL_2=

# Pinecone is hosted and requires an account API key.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=i-got-this-phase-1
PINECONE_NAMESPACE=baseline
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Corpus configuration
RAG_DATA_DIR=data/sample

# Phase 1 baseline settings
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=75
RAG_TOP_K=5
RAG_REFERENCE_DATE=2026-08-20
RAG_TIMEZONE=America/Los_Angeles

# Generation-only experiment flag: current, strict_prompt, or strict_prompt_filter.
RAG_GENERATION_MODE=strict_prompt_filter
