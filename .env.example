# Optional first name displayed in the Streamlit greeting.
APP_USER_NAME=

# Free local models served by Ollama; no API key is required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_CHAT_MODEL=gemma3:1b

# Pinecone is hosted and requires an account API key.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=i-got-this-phase-1
PINECONE_NAMESPACE=baseline
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Corpus configuration
RAG_DATA_DIR=data/sample

# Phase 1 baseline settings
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=75
RAG_TOP_K=5
RAG_REFERENCE_DATE=2026-08-20
RAG_TIMEZONE=America/Los_Angeles

# Generation-only experiment flag: current, strict_prompt, or strict_prompt_filter.
RAG_GENERATION_MODE=strict_prompt_filter
